APP_NAME=Local Multimodal RAG
APP_VERSION=1.0.0

# Strict Privacy & Offline Enforcement
OFFLINE_MODE=true

# Generation LLM Configuration (Auto-adapts to detected local Ollama/LM Studio model)
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/bartowski/Llama-3.1-8B-Lexi-Uncensored-V2-GGUF:Q4_K_M
LLM_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_NATIVE_URL=http://127.0.0.1:11434

# Embedding Model Configuration (Runs locally on CPU to preserve 4GB GPU VRAM for Llama)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Vector Database Configuration
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/vector_db

# Relational Metadata & Chat History Database
SQLITE_DB_PATH=./data/metadata/app.db

# Storage Directories
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
CACHE_DIR=./data/cache
MODELS_DIR=./models
LOG_DIR=./logs

# Intelligent Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval Parameters
TOP_K=5
HYBRID_SEARCH_ENABLED=true

# Multimodal Capabilities
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng+hin+guj
AUDIO_ENABLED=false
WHISPER_MODEL_SIZE=base

# Security & Network Limits
MAX_FILE_SIZE_MB=100
SECRET_KEY=local-rag-super-secret-jwt-key-change-in-prod-9f8e7d6c5b4a3
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
